{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-usage-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "d1_databases": [{"binding": "FEEDBACK_DB", "database_name": "ai-usage-feedback", "database_id": "60e5f6dc-224c-478a-ace4-52eaecb6de28", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "FEEDBACK_LIMITER", "namespace_id": "482071", "simple": {"limit": 5, "period": 60}}],
  "observability": {"enabled": false},
  "triggers": {"crons": ["17 3 * * *"]}
}
